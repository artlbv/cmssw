#!/usr/bin/env python3
"""hltMenuGraph: interactive producer/consumer graph of an HLT menu, as one HTML file.

Input.
 A python module name of a menu fragment (e.g. HLTrigger.Configuration.HLT_75e33_cff),
 the path of a menu fragment file, the path of a full cmsRun configuration defining
 `process`, or "-" to read a full configuration from stdin.

Output.
 A self-contained HTML page (the data is embedded; cytoscape and elkjs are loaded from
 public CDNs) with three views:
  - Modules: every scheduled module and the products it consumes, grouped by subsystem,
    CMSSW package or sequence, with a path picker and lineage tracing;
  - Paths & shared blocks: the top-level sequences shared by two or more paths, in
    dataflow order, feeding the paths that run them;
  - Path x block matrix: how many modules of each shared block every path runs.
 Optionally the extracted data as JSON (--json).

 Dependencies are read from the configuration only (InputTag/VInputTag parameters and
 strings equal to a module label; strings naming a path become path-decision edges).
 Subsystems are assigned by the rules of the profile (--profile hlt: Tools/menuGraphRules.py,
 --profile l1: Tools/menuGraphRulesL1.py); unmatched modules are listed on stderr.

Documentation: HLTrigger/Configuration/README_hltMenuGraph.md

Examples.

 # Phase-2 menu, with the era and process modifiers of the Phase-2 HLT workflows
 hltMenuGraph HLTrigger.Configuration.HLT_75e33_cff --era Phase2C22I13M9 \\
   --procModifiers alpaka -o HLT_75e33.html

 # Phase-2 L1T emulation (L1TrackTrigger, L1 and L1P2GT steps, default P2GT menu)
 hltMenuGraph --profile l1 --era Phase2C22I13M9 -o L1T_Phase2.html

 # Run-3 menu from ConfDB
 hltGetConfiguration /dev/CMSSW_X_Y_0/GRun --full --offline --unprescale | hltMenuGraph - -o GRun.html

 # without cmsenv, from a plain CMSSW checkout (generated cfi files are not available
 # there and are replaced by empty modules with --stub-missing-cfi)
 python3 HLTrigger/Configuration/scripts/hltMenuGraph HLTrigger.Configuration.HLT_75e33_cff \\
   --checkout . --stub-missing-cfi -o HLT_75e33.html
"""
import argparse
import importlib.abc
import importlib.util
import os
import sys
import tempfile


def make_python_tree(checkout):
    """Build a temporary Package/Subpackage python tree from a CMSSW checkout, as scram does."""
    checkout = os.path.abspath(checkout)
    tree = tempfile.mkdtemp(prefix="hltMenuGraph_py_")
    for pkg in sorted(os.listdir(checkout)):
        pdir = os.path.join(checkout, pkg)
        if pkg.startswith(".") or not os.path.isdir(pdir):
            continue
        for sub in sorted(os.listdir(pdir)):
            py = os.path.join(pdir, sub, "python")
            if os.path.isdir(py):
                os.makedirs(os.path.join(tree, pkg), exist_ok=True)
                init = os.path.join(tree, pkg, "__init__.py")
                if not os.path.exists(init):
                    open(init, "w").close()
                os.symlink(py, os.path.join(tree, pkg, sub))
    return tree


def install_cfi_stubs(stubbed):
    """Replace missing fillDescriptions-generated cfi modules with empty EDProducers."""
    import FWCore.ParameterSet.Config as cms

    def to_cms(value):
        if isinstance(value, bool):
            return cms.bool(value)
        if isinstance(value, int):
            return cms.int32(value)
        if isinstance(value, float):
            return cms.double(value)
        if isinstance(value, str):
            return cms.string(value)
        if isinstance(value, (list, tuple)) and all(isinstance(v, str) for v in value):
            return cms.vstring(*value)
        return value

    class Stub(cms.EDProducer):
        """Empty module standing for a generated cfi; clone() accepts plain python values."""
        def clone(self, *args, **params):
            return super().clone(*args, **{k: to_cms(v) for k, v in params.items()})

    # era modifiers may set parameters a stub does not have: set what can be converted, skip the rest
    modifier = cms._ParameterModifier
    original_call = modifier.__call__

    def lenient_call(self, obj):
        if not isinstance(obj, Stub):
            return original_call(self, obj)
        for key, value in self._ParameterModifier__args.items():
            try:
                setattr(obj, key, to_cms(value))
            except Exception:
                pass
    modifier.__call__ = lenient_call

    class Loader(importlib.abc.Loader):
        def create_module(self, spec):
            return None

        def exec_module(self, module):
            base = module.__name__.rsplit(".", 1)[1][:-len("_cfi")]
            setattr(module, base, Stub(base[0].upper() + base[1:]))
            module.__all__ = [base]
            stubbed.append(module.__name__)

            def getattr_(name):
                if name.startswith("__"):
                    raise AttributeError(name)
                obj = Stub(name[0].upper() + name[1:])
                setattr(module, name, obj)
                return obj
            module.__getattr__ = getattr_

    class Finder(importlib.abc.MetaPathFinder):
        def find_spec(self, name, path, target=None):
            if name.endswith("_cfi") and name.count(".") >= 2:
                return importlib.util.spec_from_loader(name, Loader())
            return None

    sys.meta_path.append(Finder())


def main():
    parser = argparse.ArgumentParser(prog="hltMenuGraph", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("menu", nargs="?", default=None,
                        help="menu fragment module name or file, full configuration file, or - for stdin "
                             "(optional with --profile l1: the standard Phase-2 L1T emulation is built)")
    parser.add_argument("--profile", default="hlt",
                        help="subsystem rules and page settings: hlt (default), l1, or a python module name")
    parser.add_argument("--gt-menu", default="step1_2024",
                        help="P2GT menu of the built-in L1 process (L1Trigger.Configuration.Phase2GTMenus.<name>; "
                             "default step1_2024, 'none' for no menu)")
    parser.add_argument("-o", "--output", default=None, help="output HTML file (default: <menu>_graph.html)")
    parser.add_argument("--json", default=None, help="also write the extracted data to this JSON file")
    parser.add_argument("--era", default=None, help="era(s) for a menu fragment, comma separated (e.g. Phase2C22I13M9)")
    parser.add_argument("--procModifiers", default="", help="process modifiers for a menu fragment, comma separated")
    parser.add_argument("--process-name", default=None, help="name of the process built around a menu fragment (default HLTX, L1X)")
    parser.add_argument("--title", default=None, help="page title (default from the profile, or '<menu> Dataflow')")
    parser.add_argument("--template", default=None, help="HTML template (default: HLTrigger/Configuration/data/hltMenuGraph.html)")
    parser.add_argument("--src", action="append", default=None,
                        help="source directory to scan for plugin packages (repeatable; default: "
                             "$CMSSW_BASE/src, the release src, or the checkout containing this script)")
    parser.add_argument("--checkout", default=None,
                        help="run without cmsenv, importing python packages from this CMSSW checkout")
    parser.add_argument("--stub-missing-cfi", action="store_true",
                        help="replace missing generated *_cfi modules by empty EDProducers (for --checkout)")
    args = parser.parse_args()
    if args.menu is None and args.profile != "l1":
        parser.error("a menu is required, except with --profile l1")

    if args.checkout:
        sys.path.insert(0, make_python_tree(args.checkout))
        if not args.src:
            args.src = [os.path.abspath(args.checkout)]
    stubbed = []
    if args.stub_missing_cfi:
        install_cfi_stubs(stubbed)

    from HLTrigger.Configuration.Tools import menuGraph

    modifiers = [m for m in args.procModifiers.split(",") if m]
    rules = menuGraph.profile_rules(args.profile)
    if args.menu is None:
        if not args.era:
            parser.error("the built-in L1 process needs --era (e.g. Phase2C17I13M9)")
        gt_menu = None if args.gt_menu.lower() == "none" else args.gt_menu
        process = menuGraph.load_l1_process(args.era, modifiers, gt_menu=gt_menu, process_name=args.process_name or "L1X")
    else:
        process = menuGraph.load_process(args.menu, era=args.era, modifiers=modifiers,
                                         process_name=args.process_name or "HLTX")

    src_dirs = args.src or menuGraph.default_source_dirs()
    packages = menuGraph.plugin_packages(src_dirs)
    data = menuGraph.extract(process, packages, rules)

    if args.menu is None:
        menu_name = "Phase-2 L1T emulation" + (" + P2GT %s" % args.gt_menu if args.gt_menu.lower() != "none" else "")
    elif args.menu == "-":
        menu_name = "stdin"
    elif os.path.isfile(args.menu):
        menu_name = os.path.basename(args.menu).removesuffix(".py")
    else:
        menu_name = args.menu.replace("/", ".").removesuffix(".py").split(".")[-1]
    short = "L1T_Phase2" if args.menu is None else menu_name.removesuffix("_cff")

    unclassified = [m["id"] for m in data["modules"] if m["subsystem"] == "other"]
    rules_name = getattr(rules, "__name__", args.profile).rsplit(".", 1)[-1]
    nopkg = sorted({m["type"] for m in data["modules"] if m["package"] == "(not found)"})
    print("hltMenuGraph: %d modules, %d dependencies, %d external inputs, %d paths"
          % (len(data["modules"]), len(data["edges"]), len(data["external"]), len(data["paths"])), file=sys.stderr)
    if unclassified:
        print("hltMenuGraph: %d modules match no rule in %s: %s"
              % (len(unclassified), rules_name, " ".join(unclassified)), file=sys.stderr)
    if nopkg:
        print("hltMenuGraph: no package found for %d plugin types: %s" % (len(nopkg), " ".join(nopkg)), file=sys.stderr)
    if stubbed:
        print("hltMenuGraph: stubbed generated cfi modules: %s" % " ".join(stubbed), file=sys.stderr)

    notes = ["generated cfi replaced by stubs: %s" % ", ".join(s.rsplit(".", 1)[1] for s in stubbed)] if stubbed else []
    commit = menuGraph.git_commit(src_dirs[0]) if src_dirs else None
    template = open(args.template or menuGraph.find_template()).read()
    page = menuGraph.render(data, template, title=args.title or getattr(rules, "TITLE", None) or "%s Dataflow" % short, menu=menu_name,
                            era=args.era, modifiers=modifiers, commit=commit, notes=notes)
    output = args.output or "%s_graph.html" % short
    with open(output, "w") as f:
        f.write(page)
    if args.json:
        import json
        with open(args.json, "w") as f:
            json.dump(data, f, indent=1)
    print("hltMenuGraph: wrote %s" % output, file=sys.stderr)


if __name__ == "__main__":
    main()
